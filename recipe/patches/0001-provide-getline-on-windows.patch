 #define max(a,b) (a>=b?a:b)
+
+#ifdef _WIN32
+static int compat_getline(char **lineptr, size_t *n, FILE *stream)
+{
+    size_t length = 0;
+    int character;
+
+    if (*lineptr == NULL || *n == 0) {
+        *n = 128;
+        *lineptr = malloc(*n);
+        if (*lineptr == NULL)
+            return -1;
+    }
+
+    while ((character = fgetc(stream)) != EOF) {
+        if (length + 1 >= *n) {
+            char *new_line;
+
+            *n *= 2;
+            new_line = realloc(*lineptr, *n);
+            if (new_line == NULL)
+                return -1;
+            *lineptr = new_line;
+        }
+        (*lineptr)[length++] = (char)character;
+        if (character == '\n')
+            break;
+    }
+
+    if (length == 0 && character == EOF)
+        return -1;
+    (*lineptr)[length] = '\0';
+    return (int)length;
+}
+#endif
 
 
